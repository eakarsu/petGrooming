{
  "name": "pet-grooming-app",
  "version": "1.0.0",
  "private": true,
  "description": "Governed mobile pet-grooming booking-to-payment workflow",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "create-admin": "tsx scripts/provision-admin.ts",
    "provision": "tsx scripts/provision-admin.ts",
    "worker": "tsx scripts/workflow-worker.ts",
    "worker:once": "tsx scripts/workflow-worker.ts --once",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "demo-data:load": "node scripts/load-demo-data.cjs",
    "demo-data:verify": "node scripts/load-demo-data.cjs --verify",
    "test:isolated": "node scripts/test-isolated.cjs",
    "test:unit": "tsx --test --test-concurrency=1 test/workflow.unit.test.ts test/provider-regressions.test.ts test/middleware-regressions.test.ts test/local-date.test.ts test/runtime-proxy.test.ts",
    "test:restore": "node scripts/verify-restore.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-query": "^5.17.9",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "lucide-react": "^0.303.0",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.49.2",
    "react-hot-toast": "^2.4.1",
    "resend": "6.17.2",
    "tailwind-merge": "^2.2.0",
    "twilio": "6.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.5.28",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "next-auth": {
      "uuid": "11.1.1"
    }
  }
}
